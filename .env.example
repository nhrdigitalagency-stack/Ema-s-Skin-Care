# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Random secret used to sign auth cookies
SESSION_SECRET="CHANGE_ME_TO_A_SECURE_RANDOM_SECRET"

# Sanity CMS integration (Server-side only)
SANITY_PROJECT_ID="a9j1ck41"
SANITY_ORG_ID="oh314dkvd"
SANITY_DATASET="production"
SANITY_API_TOKEN="MY_SANITY_API_TOKEN"

# Optional initial owner/admin credentials (used once on first run if no admin user exists)
# ADMIN_USERNAME="emaus.admin"
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
